# Eight-case factorial: REF, CM, DFW, NUE, and their combinations.
# All relative paths are resolved from this configuration file's directory.
RUN_ALL_COMBINATIONS=on
RUN_SCENARIOS=baseline,500c,demfwr,nue,500c_demfwr,500c_nue,demfwr_nue,500c_demfwr_nue
SCENARIO_GMD_INPUTS=off
SCENARIO_500C=off
SCENARIO_DEMFWR=off
SCENARIO_NUE=off
SCENARIO_AIR_POLLUTION=off
YEARS=2030,2050,2100
SUMMARY_REFERENCE_YEAR=2010
SUMMARY_REFERENCE_SCENARIO=SSP2_BaU_NoCC_No
RANDOM_SEED_BASE=20260918
INPUT_SET=current
INCLUDE_RESIDUE_IN_NUE=on
NUE_TARGET_FILE=data/nue_targets.csv
BASELINE_MANURE_RECYCLING_RATE=0.4
OUTPUT_DIR=../output/scenarios
EXPORT_VISITORN=on
VISITORN_OUTPUT_DIR=../../VISIToRN/Data_pd/scenarios
RAW_MODEL_SCRIPT=../R/RawDataProcess.R
FAIL_FAST=on
GAMS_DIR=
PLOT_SCENARIOS=baseline,500c,demfwr,nue,500c_demfwr,500c_nue,demfwr_nue,500c_demfwr_nue
PLOT_YEARS=2030,2050,2100
PLOT_MAPS=on
PLOT_OUTPUT_DIR=
